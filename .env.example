# Copy this file to `.env` and fill in your own values before running locally.
# Required for both `npm run dev` (SSR) and the Vite client bundle.

# Public Supabase project (server + client)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXX"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT"

# Same values, no VITE_ prefix — read by the server (SSR / server functions / api routes)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXX"
SUPABASE_PROJECT_ID="YOUR-PROJECT"

# Server-only secret (never expose to the client / never commit).
# Needed for privileged writes and storage signed URLs used by /api/public/link.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_XXXXXXXXXXXXXXXXXXXX"

# ============================================
# AI ASSISTANT CONFIGURATION (Server-only)
# ============================================
# Choose your AI provider: "anthropic" or "openai"
AI_PROVIDER="anthropic"

# Anthropic Claude API Key (get from: https://console.anthropic.com/)
# Recommended: Claude 3.7 Sonnet for agentic tasks, extended thinking, and tool use
ANTHROPIC_API_KEY="sk-ant-api03-XXXXXXXXXXXXXXXXXXXX"
AI_MODEL="claude-3-7-sonnet-20250219"

# OR use Omniroute local proxy (Claude Code / claude-omniroute)
# ANTHROPIC_BASE_URL="http://localhost:20128"
# ANTHROPIC_AUTH_TOKEN="sk-XXXXXXXXXXXXXXXXXXXX"
# ANTHROPIC_MODEL="Filelink"
# ANTHROPIC_API_KEY=""

# OR OpenAI API Key (get from: https://platform.openai.com/)
# OPENAI_API_KEY="sk-XXXXXXXXXXXXXXXXXXXX"
# AI_MODEL="gpt-4o"

